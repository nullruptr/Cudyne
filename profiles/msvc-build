[settings]
arch=x86_64
build_type=Release
compiler=msvc
compiler.cppstd=14
compiler.runtime=static
compiler.runtime_type=Release
compiler.version=193
os=Windows

[conf]
# ビルドツール (gettext 等の tool_requires) は既定では ~/.conan2/profiles/default が
# ビルドコンテキストのプロファイルとして使われ、msvc-release/msvc-debug の [conf] が
# 適用されない。日本語環境 (コードページ 932) での "予期しない #endif" 等のビルドエラーを
# 避けるため、ビルドコンテキスト用にも同じ /utf-8 指定を明示する。
tools.build:cflags=["-utf-8"]
tools.build:cxxflags=["-utf-8"]
